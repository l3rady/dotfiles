{{- /* Asked once on first run, then remembered in ~/.config/chezmoi/chezmoi.toml (never committed). */ -}}
{{- $name := promptStringOnce . "name" "Your name for git commits" -}}
{{- $email := promptStringOnce . "email" "Your email for git commits" -}}
{{- $isWSL := and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
{{- $virt := "" -}}
{{- if and (eq .chezmoi.os "linux") (not $isWSL) (lookPath "systemd-detect-virt") -}}
{{-   $virt = trim (output "sh" "-c" "systemd-detect-virt --vm 2>/dev/null || true") -}}
{{- end -}}
{{- $isVM := and (not $isWSL) (ne $virt "") (ne $virt "none") -}}

sourceDir = {{ .chezmoi.workingTree | quote }}
# Pin file/dir modes to 0644/0755 regardless of whether a shell uses umask 022 or Ubuntu's 002
umask = 0o022

[add]
    # Refuse to `chezmoi add` a file that looks like it contains a secret
    secrets = "error"

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    isWSL = {{ $isWSL }}
    isVM = {{ $isVM }}
