{{- /* The secret held by the Bitwarden item whose name is exactly `.`:
       a Secure note's text, or a Login's Password (by item type: 1 = Login,
       2 = Secure note). Use: {{ includeTemplate "bitwarden-secret" "Item name" }}

       Why not chezmoi's `bitwarden "item" "name"`: it runs `bw get item <name>`,
       which is a full-text search (names *and* note contents), so a note that
       merely mentions another item's name makes the lookup ambiguous and it fails.
       Here we search, keep only exact (case-sensitive) name matches, and require
       exactly one. `bw list items` excludes the trash. */ -}}
{{- $name := . -}}
{{- $matches := list -}}
{{- range (output "bw" "list" "items" "--search" $name | fromJson) -}}
{{-   if eq .name $name }}{{ $matches = append $matches . }}{{ end -}}
{{- end -}}
{{- if ne (len $matches) 1 -}}
{{-   fail (printf "Bitwarden: expected exactly one item named %q, found %d (names must be unique)" $name (len $matches)) -}}
{{- end -}}
{{- $item := index $matches 0 -}}
{{- $value := "" -}}
{{- if eq (int $item.type) 2 }}{{ $value = $item.notes | default "" | trim }}
{{- else }}{{ $value = dig "login" "password" "" $item | trim }}{{ end -}}
{{- if not $value }}{{ fail (printf "Bitwarden item %q has no value (note text or Login password)" $name) }}{{ end -}}
{{- $value -}}
