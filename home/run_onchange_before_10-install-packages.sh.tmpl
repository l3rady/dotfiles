#!/usr/bin/env bash
# Generated from .chezmoidata/packages.yaml. chezmoi re-runs this whenever
# the rendered script changes, i.e. whenever you edit a package list.
set -euo pipefail

{{ if .packages.docker -}}
# Docker's apt repository (https://docs.docker.com/engine/install/ubuntu/)
if [ ! -f /etc/apt/sources.list.d/docker.sources ]; then
  echo "==> Adding Docker's apt repository"
  sudo install -m 0755 -d /etc/apt/keyrings
  sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  sudo chmod a+r /etc/apt/keyrings/docker.asc
  sudo tee /etc/apt/sources.list.d/docker.sources >/dev/null <<DOCKER
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
Components: stable
Signed-By: /etc/apt/keyrings/docker.asc
DOCKER
fi
{{ end -}}

echo "==> apt"
sudo apt-get update
sudo apt-get install -y {{ concat .packages.apt .packages.docker | join " " }}

{{ if .locale -}}
# Generate the locale .zshrc uses (needs the locales package, installed above).
# Enable it in /etc/locale.gen first, so this works whether or not locale-gen
# accepts locale names as arguments (Ubuntu does, Debian doesn't).
if ! locale -a 2>/dev/null | grep -qix '{{ .locale | replace "UTF-8" "utf8" }}'; then
  echo "==> Generating locale {{ .locale }}"
  if grep -qE '^#? *{{ .locale | replace "." "\\." }} ' /etc/locale.gen 2>/dev/null; then
    sudo sed -i -E 's/^# *({{ .locale | replace "." "\\." }} )/\1/' /etc/locale.gen
  else
    echo '{{ .locale }} UTF-8' | sudo tee -a /etc/locale.gen >/dev/null
  fi
  sudo locale-gen
fi
{{ end -}}

{{ if .packages.docker -}}
# Run docker without sudo (takes effect in a new login shell)
if ! id -nG "$USER" | grep -qw docker; then
  sudo usermod -aG docker "$USER"
fi
{{- if .isWSL }}
# Docker's daemon needs systemd, which WSL only starts when asked to.
# Edit [boot] in place if present so we never create duplicate [boot] sections
# or glue onto a line without a trailing newline.
if [ "$(sudo python3 - /etc/wsl.conf <<'PY'
import pathlib, re, sys

path = pathlib.Path(sys.argv[1])
lines = path.read_text().splitlines(keepends=True) if path.exists() else []

in_boot = False
boot_idx = None
systemd_idx = None
already_true = False

for i, line in enumerate(lines):
    stripped = line.strip()
    if stripped.startswith("[") and stripped.endswith("]"):
        in_boot = stripped.lower() == "[boot]"
        if in_boot and boot_idx is None:
            boot_idx = i
    elif in_boot and re.match(r"^systemd\s*=", stripped, re.IGNORECASE):
        systemd_idx = i
        if re.match(r"^systemd\s*=\s*true(\s*(#.*|;.*)?)?$", stripped, re.IGNORECASE):
            already_true = True
        break

if already_true:
    sys.exit(0)

if systemd_idx is not None:
    lines[systemd_idx] = "systemd=true\n"
elif boot_idx is not None:
    if not lines[boot_idx].endswith("\n"):
        lines[boot_idx] += "\n"
    lines.insert(boot_idx + 1, "systemd=true\n")
else:
    if lines and not lines[-1].endswith("\n"):
        lines[-1] += "\n"
    if lines and lines[-1].strip() != "":
        lines.append("\n")
    lines.extend(["[boot]\n", "systemd=true\n"])

path.write_text("".join(lines))
print("changed")
PY
)" = "changed" ]; then
  echo "!! Enabled systemd in /etc/wsl.conf: run 'wsl --shutdown' in Windows, then reopen Ubuntu"
fi
{{- end }}
{{ end -}}

BREW=/home/linuxbrew/.linuxbrew/bin/brew
if [ ! -x "$BREW" ]; then
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$("$BREW" shellenv)"

{{ range .packages.taps -}}
brew tap {{ . | quote }}
brew trust --tap {{ . | quote }}
{{ end }}
echo "==> brew bundle"
# brew bundle tries every entry before exiting, so one failure does not skip the rest.
# Exit non-zero at the end if anything failed so chezmoi does not record the script as
# done and the next `chezmoi apply` retries it.
brew_rc=0
brew bundle --file=- <<'BREWFILE' || brew_rc=$?
{{ range .packages.brew -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.casks -}}
cask {{ . | quote }}
{{ end -}}
BREWFILE

# The one-line install leaves a bootstrap chezmoi in ~/.local/bin. Homebrew's
# copy replaces it (and gets updated), so remove the bootstrap one.
if brew list --formula chezmoi >/dev/null 2>&1; then
  rm -f "$HOME/.local/bin/chezmoi"
fi

if [ "$brew_rc" -ne 0 ]; then
  echo "!! Some brew packages failed (see above). Re-run 'chezmoi apply' to retry (or fix packages.yaml first)." >&2
  exit "$brew_rc"
fi
