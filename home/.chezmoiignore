# oh-my-zsh writes its cache inside ~/.oh-my-zsh; keep chezmoi from wiping it
.oh-my-zsh/cache/**

# Claude Code: only hand-written config is tracked (see README). Never let
# credentials, history or machine state be added, even by accident.
.claude.json
.claude/.credentials.json
.claude/settings.local.json
.claude/projects
.claude/sessions
.claude/history.jsonl
.claude/file-history
.claude/shell-snapshots
.claude/backups
.claude/cache
.claude/state
.claude/session-env
.claude/downloads
.claude/skills/synced
.claude/plugins

# Codex: only the shared AGENTS.md is tracked; never its logins or history
.codex/auth.json
.codex/sessions
.codex/history.jsonl
.codex/log

# Antigravity (Gemini): only hand-written global instructions and agents are tracked
.gemini/antigravity-cli
.gemini/config/config.json
.gemini/config/projects
.gemini/config/mcp_config.json
.gemini/config/.migrated

# Kubernetes credentials: generated per machine, never tracked
.kube

# Terraform: `terraform login` API tokens
.terraform.d/credentials.tfrc.json

# WSL-only clipboard helpers (don't shadow macOS's built-in pbcopy/pbpaste)
{{- if not .isWSL }}
.local/bin/pbcopy
.local/bin/pbpaste
{{- end }}

# Native Linux VM tweaks (skipped on WSL and bare-metal installs)
{{- if not (get . "isVM") }}
35-configure-vm.sh
{{- end }}

# T3 Code manages its own versioned systemd user unit (`t3 service install` / `t3 update`)
.config/systemd/user/t3code.service
.config/systemd/user/default.target.wants

# Files built from Bitwarden are skipped unless the vault is really unlocked
# (see .chezmoitemplates/bitwarden-unlocked). Skipping (rather than rendering
# empty) also stops chezmoi deleting these files while the vault is locked.
{{- if not (includeTemplate "bitwarden-unlocked") }}
.ssh/id_ed25519
.ssh/id_ed25519.pub
.config/sops/age/keys.txt
.cloudflared/cert.pem
.cloudflared/credentials.json
.talos/config
.config/zsh/secrets.zsh
{{- end }}
