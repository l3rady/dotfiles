# oh-my-zsh writes its cache inside ~/.oh-my-zsh; keep chezmoi from wiping it
.oh-my-zsh/cache/**

# Claude Code: only hand-written config is tracked (see README). Never let
# credentials, history or machine state be added, even by accident.
.claude.json
.claude/.credentials.json
.claude/settings.local.json
.claude/projects
.claude/sessions
.claude/history.jsonl
.claude/file-history
.claude/shell-snapshots
.claude/backups
.claude/cache
.claude/state
.claude/session-env
.claude/downloads
.claude/skills/synced
.claude/plugins

# Codex / opencode: only the shared AGENTS.md is tracked; never their logins or history
.codex/auth.json
.codex/sessions
.codex/history.jsonl
.codex/log
.local/share/opencode

# Kubernetes credentials: generated per machine, never tracked
.kube

# Terraform: `terraform login` API tokens
.terraform.d/credentials.tfrc.json

# Files built from Bitwarden are skipped unless the vault is really unlocked.
# BW_SESSION alone isn't enough: a stale session makes bw prompt for the master
# password. `bw status` never prompts. Skipping (rather than rendering empty)
# also stops chezmoi deleting these files while the vault is locked.
{{- $bwUnlocked := and (env "BW_SESSION") (lookPath "bw") (eq (output "bw" "status" | fromJson).status "unlocked") }}
{{- if not $bwUnlocked }}
.config/sops/age/keys.txt
.cloudflared/cert.pem
.cloudflared/credentials.json
.talos/config
.config/zsh/secrets.zsh
{{- end }}
