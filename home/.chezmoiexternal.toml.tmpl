# Downloaded by chezmoi, refreshed weekly (`chezmoi apply --refresh-externals` forces it).
[".oh-my-zsh"]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/HEAD.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
{{ range .omz.custom_plugins }}
[".oh-my-zsh/custom/plugins/{{ .name }}"]
    type = "archive"
    url = "{{ .repo }}/archive/HEAD.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
{{ end -}}

# talosctl pinned to the cluster's Talos version (see .chezmoidata/talos.yaml)
[".local/bin/talosctl"]
    type = "file"
    url = "https://github.com/siderolabs/talos/releases/download/{{ .talos.version }}/talosctl-{{ .chezmoi.os }}-{{ .chezmoi.arch }}"
    executable = true
    checksum.sha256 = "{{ index .talos.talosctlSha256 .chezmoi.arch }}"

# amtool (Alertmanager CLI) pinned to the cluster's Alertmanager version
# (see .chezmoidata/alertmanager.yaml). Extracted from the release tarball.
[".local/bin/amtool"]
    type = "archive-file"
    url = "https://github.com/prometheus/alertmanager/releases/download/{{ .alertmanager.version }}/alertmanager-{{ trimPrefix "v" .alertmanager.version }}.{{ .chezmoi.os }}-{{ .chezmoi.arch }}.tar.gz"
    path = "alertmanager-{{ trimPrefix "v" .alertmanager.version }}.{{ .chezmoi.os }}-{{ .chezmoi.arch }}/amtool"
    executable = true
    checksum.sha256 = "{{ index .alertmanager.tarballSha256 .chezmoi.arch }}"

# Skill packs read only by subagents (see claude.agentSkills in .chezmoidata/claude.yaml).
# Pinned to a reviewed commit, verified by checksum, and kept outside ~/.claude/skills.
{{ range $name, $pack := .claude.agentSkills }}
[".claude/agent-skills/{{ $name }}"]
    type = "archive"
    url = "https://github.com/{{ $pack.repo }}/archive/{{ $pack.commit }}.tar.gz"
    exact = true
    stripComponents = 1
    include = ["*/skills/**", "*/LICENSE"]
    checksum.sha256 = "{{ $pack.sha256 }}"
{{ end -}}
