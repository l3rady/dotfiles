# Downloaded by chezmoi, refreshed weekly (`chezmoi apply --refresh-externals` forces it).
[".oh-my-zsh"]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/HEAD.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
{{ range .omz.custom_plugins }}
[".oh-my-zsh/custom/plugins/{{ .name }}"]
    type = "archive"
    url = "{{ .repo }}/archive/HEAD.tar.gz"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
{{ end -}}

# talosctl pinned to the cluster's Talos version (see .chezmoidata/talos.yaml)
[".local/bin/talosctl"]
    type = "file"
    url = "https://github.com/siderolabs/talos/releases/download/{{ .talos.version }}/talosctl-{{ .chezmoi.os }}-{{ .chezmoi.arch }}"
    executable = true
    checksum.sha256 = "{{ index .talos.talosctlSha256 .chezmoi.arch }}"
