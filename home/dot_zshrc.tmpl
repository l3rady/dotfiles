# Managed by chezmoi. Edit with `zshconfig` (chezmoi edit --apply ~/.zshrc).
# Machine-specific or secret settings go in ~/.zshrc.local (not tracked).

eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"

# Per-user installs (Claude Code, pipx, uv tools...). Ubuntu adds this in
# ~/.profile, which zsh doesn't read.
export PATH="$HOME/.local/bin:$PATH"

# Locale. Only set if generated, otherwise every command warns about it
# (the install script generates it).
if locale -a 2>/dev/null | grep -qix '{{ .locale | replace "UTF-8" "utf8" }}'; then
  export LANG={{ .locale }} LC_ALL={{ .locale }} LANGUAGE={{ .locale }}
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # starship draws the prompt
HIST_STAMPS="yyyy-mm-dd"
# chezmoi keeps oh-my-zsh up to date (weekly), so its own updater is off
zstyle ':omz:update' mode disabled

# Extra completions (must be on fpath before oh-my-zsh runs compinit)
fpath+=(~/.zsh/completion)

plugins=(
{{- range .omz.plugins }}
  {{ . }}
{{- end }}
)
source "$ZSH/oh-my-zsh.sh"

export EDITOR=nano
export TF_CLI_CONFIG_FILE="$HOME/.config/terraform/.terraformrc"
{{- if .isWSL }}

# WSL: open links in the Windows browser, scale Linux GUI apps (WSLg)
export BROWSER="/mnt/c/Windows/explorer.exe"
export GDK_DPI_SCALE=1.5
{{- end }}

# Aliases
alias zshconfig="chezmoi edit --apply ~/.zshrc"
alias ohmyzsh='$EDITOR "$(chezmoi source-path)/.chezmoidata/zsh.yaml" && chezmoi apply'
for alias_file in ~/.config/zsh/aliases/*.zsh(N); do
  source "$alias_file"
done

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# fzf key bindings: Ctrl-R history, Ctrl-T files, Alt-C cd, and ** completion
source <(fzf --zsh)
eval "$(starship init zsh)"
# zoxide replaces cd (`cd foo` jumps to the best match). Keep this last.
eval "$(zoxide init zsh --cmd cd)"
