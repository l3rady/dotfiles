# Managed by chezmoi (home/dot_config/shell/env.sh.tmpl).
# Shared POSIX-compatible, secret-free environment sourced by ~/.zshrc,
# ~/.bashrc, and non-interactive AI agent Bash sessions (CLAUDE_ENV_FILE).
# Never put interactive shell hooks or secrets here.

if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  case ":$PATH:" in
    *":/home/linuxbrew/.linuxbrew/bin:"*)
      if [ -z "${HOMEBREW_PREFIX:-}" ]; then
        export HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew"
        export HOMEBREW_CELLAR="/home/linuxbrew/.linuxbrew/Cellar"
        export HOMEBREW_REPOSITORY="/home/linuxbrew/.linuxbrew/Homebrew"
      fi
      ;;
    *)
      eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv sh)"
      ;;
  esac
fi

# Put mise shims ahead of Homebrew so mise's Node and Terraform take precedence
# over Homebrew's node in non-interactive shells (without oh-my-zsh's mise plugin).
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) export PATH="$HOME/.local/share/mise/shims:$PATH" ;;
esac

# Per-user installs (amtool, talosctl, memcap, uv tools...).
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
{{- if .locale }}

# Locale (generated by run_onchange_before_10-install-packages.sh.tmpl)
export LANG={{ .locale }}
export LC_ALL={{ .locale }}
export LANGUAGE={{ .locale }}
{{- end }}

export EDITOR=nano
# Terraform: config in ~/.config, providers cached in ~/.cache (see .terraformrc),
# and no update check, which is what writes checkpoint files to ~/.terraform.d
export TF_CLI_CONFIG_FILE="$HOME/.config/terraform/.terraformrc"
export CHECKPOINT_DISABLE=1
{{- if .isWSL }}

# WSL: open links in the Windows browser, scale Linux GUI apps (WSLg)
export BROWSER="/mnt/c/Windows/explorer.exe"
export GDK_DPI_SCALE=1.5
{{- end }}
