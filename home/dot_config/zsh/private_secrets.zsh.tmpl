{{- /* Secret environment variables from Bitwarden, listed in
       .chezmoidata/secrets.yaml. Only rendered while Bitwarden is unlocked;
       see .chezmoiignore. Sourced by ~/.zshrc.
       A Secure note gives its note text; a Login gives its Password field
       (decided by item type: 1 = Login, 2 = Secure note). */ -}}
# Managed by chezmoi from Bitwarden. Don't edit: change .chezmoidata/secrets.yaml.
{{ range .secretEnv -}}
{{- $item := bitwarden "item" .item -}}
{{- $value := "" -}}
{{- if eq (int $item.type) 2 }}{{ $value = $item.notes | default "" | trim }}
{{- else }}{{ $value = dig "login" "password" "" $item | trim }}{{ end -}}
{{- if not $value }}{{ fail (printf "Bitwarden item %q has no value (note text or Login password)" .item) }}{{ end -}}
export {{ .name }}={{ $value | squote }}
{{ end -}}
