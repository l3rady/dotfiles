#!/usr/bin/env python3
# chezmoi modify script for ~/.claude/settings.json: reads the current file on
# stdin and writes it back with the keys from .chezmoidata/claude.yaml set.
# Keys it doesn't manage are kept as they are, and managed hooks are reconciled
# alongside hooks added by plugins or /hooks.
import json
import os
import sys

managed = json.loads(r'''{{ .claude.settings | toJson }}''')

current = sys.stdin.read()
try:
    settings = json.loads(current) if current.strip() else {}
except json.JSONDecodeError as err:
    # Never overwrite a file we can't parse: fail the apply instead.
    sys.exit(f"~/.claude/settings.json is not valid JSON ({err}); fix it and re-run chezmoi apply")

# Only replace values whose content differs, so key order Claude Code chose
# is kept and an unchanged file stays byte-for-byte the same.
for key, value in managed.items():
    if key in ("hooks", "env", "permissions"):
        continue
    if settings.get(key) != value:
        settings[key] = value

# Managed env keys are merged into settings["env"] so machine-local or
# plugin-added env vars are preserved. Expand leading ~/ for path values.
managed_env = managed.get("env", {})
if isinstance(managed_env, dict) and managed_env:
    existing_env = settings.get("env")
    if not isinstance(existing_env, dict):
        existing_env = {}
        settings["env"] = existing_env
    for env_key, env_val in managed_env.items():
        if isinstance(env_val, str) and env_val.startswith("~/"):
            env_val = os.path.expanduser(env_val)
        if existing_env.get(env_key) != env_val:
            existing_env[env_key] = env_val

# Managed permissions lists (e.g. deny rules) are merged without clobbering
# permissions.defaultMode or unmanaged allow/ask/deny entries.
managed_perms = managed.get("permissions", {})
if isinstance(managed_perms, dict) and managed_perms:
    existing_perms = settings.get("permissions")
    if not isinstance(existing_perms, dict):
        existing_perms = {}
        settings["permissions"] = existing_perms
    for perm_key, perm_val in managed_perms.items():
        if isinstance(perm_val, list):
            current_list = existing_perms.get(perm_key)
            if not isinstance(current_list, list):
                current_list = []
                existing_perms[perm_key] = current_list
            for rule in perm_val:
                if rule not in current_list:
                    current_list.append(rule)
        elif existing_perms.get(perm_key) != perm_val:
            existing_perms[perm_key] = perm_val

# Managed hooks live under ~/.claude/hooks/ (from dot_claude/hooks/). Any entry
# whose commands all come from that directory is owned by chezmoi, so edits or
# removals in claude.yaml reconcile cleanly without touching plugin or /hooks
# entries.
managed_prefixes = ("~/.claude/hooks/", os.path.expanduser("~/.claude/hooks/"))


def is_managed_hook_entry(entry):
    if not isinstance(entry, dict):
        return False
    items = entry.get("hooks")
    if not isinstance(items, list) or not items:
        return False
    return all(
        isinstance(item, dict)
        and item.get("type") == "command"
        and isinstance(item.get("command"), str)
        and item["command"].startswith(managed_prefixes)
        for item in items
    )


managed_hooks = managed.get("hooks", {})
existing_hooks = settings.get("hooks")
if isinstance(existing_hooks, dict):
    for event in list(existing_hooks.keys()):
        entries = existing_hooks[event]
        if not isinstance(entries, list):
            continue
        desired = managed_hooks.get(event, [])
        filtered = [
            entry for entry in entries
            if not is_managed_hook_entry(entry) or entry in desired
        ]
        if filtered != entries:
            if filtered:
                existing_hooks[event] = filtered
            else:
                del existing_hooks[event]
    if not existing_hooks and not managed_hooks:
        del settings["hooks"]

for event, entries in managed_hooks.items():
    current_entries = settings.setdefault("hooks", {}).setdefault(event, [])
    for entry in entries:
        if entry not in current_entries:
            current_entries.append(entry)

print(json.dumps(settings, indent=2, ensure_ascii=False))
