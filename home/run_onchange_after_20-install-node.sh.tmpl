#!/usr/bin/env bash
# Global tools with mise (Node LTS, Terraform), then global npm packages with npm. chezmoi re-runs
# this whenever packages.mise or packages.npm changes. To move to a newer LTS
# later run `mise upgrade node`: mise installs ~/.default-npm-packages into it.
set -euo pipefail

eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
export MISE_YES=1 # never stop to ask during chezmoi apply
cd "$HOME"        # so mise uses the global config, not a project's

if ! command -v mise >/dev/null; then
  echo "!! mise not installed (brew bundle failed?), skipping Node setup"
  exit 0
fi

{{ range .packages.mise -}}
echo "==> mise: {{ . }}"
mise use --global {{ . | quote }}
{{ end -}}

# Into mise's Node (its global prefix is user-writable, so tools can self-update).
# Only missing packages: installed ones keep updating themselves.
{{ range .packages.npm -}}
if ! mise exec -- npm ls --global --depth=0 {{ . | quote }} >/dev/null 2>&1; then
  echo "==> npm: {{ . }}"
  mise exec -- npm install --global {{ . | quote }}
fi
{{ end -}}
