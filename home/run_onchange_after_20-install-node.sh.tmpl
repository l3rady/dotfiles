#!/usr/bin/env bash
# Node (latest LTS) and global npm packages, managed by Volta. chezmoi re-runs
# this whenever packages.volta changes; to move to a newer LTS run
# `volta install node`.
set -euo pipefail

eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$PATH"

if ! command -v volta >/dev/null; then
  echo "!! volta not installed (brew bundle failed?), skipping Node setup"
  exit 0
fi

echo "==> volta: node (LTS)"
volta install node
{{- range .packages.volta }}
volta install {{ . | quote }}
{{- end }}
