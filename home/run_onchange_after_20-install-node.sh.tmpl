#!/usr/bin/env bash
# Node (latest LTS) and global npm packages, installed globally with mise from
# packages.mise. chezmoi re-runs this whenever that list changes; to move to a
# newer LTS later run `mise upgrade node` (or `mise up` for everything).
set -euo pipefail

eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
export MISE_YES=1 # never stop to ask during chezmoi apply

if ! command -v mise >/dev/null; then
  echo "!! mise not installed (brew bundle failed?), skipping Node setup"
  exit 0
fi

{{ range .packages.mise -}}
echo "==> mise: {{ . }}"
mise use --global {{ . | quote }}
{{ end -}}
