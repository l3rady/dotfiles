#!/usr/bin/env bash
# Refuse any commit whose staged changes contain a secret.
# Enabled by install.sh via `git config core.hooksPath .githooks`.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found, refusing to commit unscanned changes." >&2
  echo "Install it with: brew install gitleaks" >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner
